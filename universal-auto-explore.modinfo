<?xml version="1.0" encoding="utf-8"?>
<Mod id="universal-auto-explore" version="1" xmlns="ModInfo">
	<Properties>
		<Name>LOC_MOD_UNIVERSAL_AUTO_EXPLORE_NAME</Name>
		<Description>LOC_MOD_UNIVERSAL_AUTO_EXPLORE_DESCRIPTION</Description>
		<Authors>Tower</Authors>
		<Package>UniversalAutoExplore</Package>
		<PackageSortIndex>1000</PackageSortIndex>
		<ShowInBrowser>1</ShowInBrowser>
		<Version>1.2.0</Version>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<!-- AlwaysMet ensures the patch runs when loading an existing save as well
		     as when starting a new game, so save resumes keep auto-explore coverage. -->
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<!-- Shell scope: the mod's name and description in the Additional Content browser, and its group checkboxes
		     in the main-menu Options screen, which run before any game is loaded. Each translation loads only when
		     the game is in that language. -->
		<ActionGroup id="universal-auto-explore-shell" scope="shell" criteria="always">
			<Actions>
				<UpdateText>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item locale="de_DE">text/de_de/ModuleText.xml</Item>
					<Item locale="es_ES">text/es_es/ModuleText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/ModuleText.xml</Item>
					<Item locale="it_IT">text/it_it/ModuleText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/ModuleText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/ModuleText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/ModuleText.xml</Item>
					<Item locale="pt_BR">text/pt_br/ModuleText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/ModuleText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/ModuleText.xml</Item>
				</UpdateText>
				<UIScripts>
					<Item>ui/uae-options.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/uae-mod-options.js</Item>
					<Item>ui/uae-options.js</Item>
					<Item>ui/uae-settings.js</Item>
					<Item>ui/uae-unit-classes.js</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
		<!-- High LoadOrder so this runs after every unit type (base, age, and DLC)
		     has been inserted into the current age's database. The UI scripts add the in-game Options rows and
		     drop the action from the unit panel for groups or units the player turned off. -->
		<ActionGroup id="universal-auto-explore-grant" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>data/grant-autoexplore.sql</Item>
					<Item>data/uae-civilopedia.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item locale="de_DE">text/de_de/ModuleText.xml</Item>
					<Item locale="es_ES">text/es_es/ModuleText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/ModuleText.xml</Item>
					<Item locale="it_IT">text/it_it/ModuleText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/ModuleText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/ModuleText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/ModuleText.xml</Item>
					<Item locale="pt_BR">text/pt_br/ModuleText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/ModuleText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/ModuleText.xml</Item>
				</UpdateText>
				<UIScripts>
					<Item>ui/uae-options.js</Item>
					<Item>ui/uae-unit-actions.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/uae-mod-options.js</Item>
					<Item>ui/uae-options.js</Item>
					<Item>ui/uae-settings.js</Item>
					<Item>ui/uae-unit-actions.js</Item>
					<Item>ui/uae-unit-classes.js</Item>
				</ImportFiles>
			</Actions>
			<Properties>
				<LoadOrder>9999</LoadOrder>
			</Properties>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>text/en_us/ModuleText.xml</File>
	</LocalizedText>
</Mod>
