<?xml version="1.0" encoding="utf-8"?>
<Mod id="universal-auto-explore" version="1" xmlns="ModInfo">
	<Properties>
		<Name>LOC_MOD_UNIVERSAL_AUTO_EXPLORE_NAME</Name>
		<Description>LOC_MOD_UNIVERSAL_AUTO_EXPLORE_DESCRIPTION</Description>
		<Authors>Tower</Authors>
		<Package>UniversalAutoExplore</Package>
		<PackageSortIndex>1000</PackageSortIndex>
		<ShowInBrowser>1</ShowInBrowser>
		<Version>1.2.4</Version>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<!-- AlwaysMet, so the patch runs when a save is loaded as well as when a new game starts;
		     a resumed save keeps its auto-explore coverage. -->
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
		<!-- Civilopedia History Corrections: the history text on six independent-power pages from Civilopedia
		     Expanded: Independents. Each group needs that mod in use, so without it the game's pages are left as
		     they are. The text in history-corrections/ is a copy kept in step with the standalone mod. -->
		<Criteria id="history-corrections-antiquity">
			<ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="history-corrections-exploration">
			<ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="history-corrections-exploration-sengoku">
			<ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ModInUse>sengoku</ModInUse>
		</Criteria>
		<Criteria id="history-corrections-exploration-mlcs">
			<ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<ModInUse>ml-city-states-expanded</ModInUse>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<!-- Shell scope: the mod's name and description in the Additional Content browser, and its group checkboxes
		     in the main-menu Options screen, which run before any game is loaded. Each translation loads only when
		     the game is in that language. -->
		<ActionGroup id="universal-auto-explore-shell" scope="shell" criteria="always">
			<Actions>
				<UpdateText>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item locale="de_DE">text/de_de/ModuleText.xml</Item>
					<Item locale="es_ES">text/es_es/ModuleText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/ModuleText.xml</Item>
					<Item locale="it_IT">text/it_it/ModuleText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/ModuleText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/ModuleText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/ModuleText.xml</Item>
					<Item locale="pt_BR">text/pt_br/ModuleText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/ModuleText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/ModuleText.xml</Item>
				</UpdateText>
				<UIScripts>
					<!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
					<Item>ui/settings-keeper.js</Item>
					<Item>ui/uae-options.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/uae-mod-options.js</Item>
					<Item>ui/uae-options.js</Item>
					<Item>ui/uae-settings.js</Item>
					<Item>ui/uae-unit-classes.js</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
		<!-- High LoadOrder so this runs after every unit type (base, age, and DLC)
		     has been inserted into the current age's database. The UI scripts add the in-game Options rows and
		     drop the action from the unit panel for groups or units the player turned off, and keep the map lens the game
		     would pick for the units the patch tagged. -->
		<ActionGroup id="universal-auto-explore-grant" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>data/grant-autoexplore.sql</Item>
					<Item>data/uae-civilopedia.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item locale="de_DE">text/de_de/ModuleText.xml</Item>
					<Item locale="es_ES">text/es_es/ModuleText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/ModuleText.xml</Item>
					<Item locale="it_IT">text/it_it/ModuleText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/ModuleText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/ModuleText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/ModuleText.xml</Item>
					<Item locale="pt_BR">text/pt_br/ModuleText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/ModuleText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/ModuleText.xml</Item>
				</UpdateText>
				<UIScripts>
					<!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
					<Item>ui/settings-keeper.js</Item>
					<Item>ui/uae-options.js</Item>
					<Item>ui/uae-unit-actions.js</Item>
					<Item>ui/uae-unit-lens.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/uae-mod-options.js</Item>
					<Item>ui/uae-options.js</Item>
					<Item>ui/uae-settings.js</Item>
					<Item>ui/uae-unit-actions.js</Item>
					<Item>ui/uae-unit-classes.js</Item>
					<Item>ui/uae-lens-keep.js</Item>
					<Item>ui/uae-unit-lens.js</Item>
				</ImportFiles>
			</Actions>
			<Properties>
				<LoadOrder>9999</LoadOrder>
			</Properties>
		</ActionGroup>
		<!-- Civilopedia History Corrections, loaded at 1000 to come after Civilopedia Expanded's groups (10, 100
		     and 210). Text only. -->
		<ActionGroup id="history-corrections-antiquity-text" scope="game" criteria="history-corrections-antiquity">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
					<Item>history-corrections/antiquity-text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="history-corrections-exploration-text" scope="game" criteria="history-corrections-exploration">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
					<Item>history-corrections/exploration-text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="history-corrections-exploration-sengoku-text" scope="game" criteria="history-corrections-exploration-sengoku">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
					<Item>history-corrections/exploration-sengoku-text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="history-corrections-exploration-mlcs-text" scope="game" criteria="history-corrections-exploration-mlcs">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateText>
					<Item>history-corrections/exploration-mlcs-text.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>text/en_us/ModuleText.xml</File>
	</LocalizedText>
</Mod>
